# MeshKore standard v35 §2 — v27 deny-list.
# Commit: .meshkore/public/, docs/, modules/, roadmap/initiatives/, STANDARD_VERSION.
# Ignore: everything else under .meshkore/ (runtime/secret/per-machine state).
.meshkore/.runtime/
.meshkore/credentials/
.meshkore/agents/
.meshkore/timeline/
.meshkore/log/
.meshkore/queues/
.meshkore/uploads/
.meshkore/snapshots/
.meshkore/state.json
.meshkore/roadmap/state.json
.meshkore/roadmap/state.js
.meshkore/scripts/

# Build and tooling
node_modules/
dist/
*.tsbuildinfo
.vite/

# Local scratch (operator's own working copies)
tmp/

.DS_Store
.wrangler/

# End-to-end runner: the test wallet's key and the chains/reports a run writes.
apps/web/.e2e-wallet.json
apps/web/.platform-cert-key.json
apps/web/.e2e-runs/

# Browser suite output: traces, screenshots, reports.
apps/web/e2e-output/
apps/web/test-results/
apps/web/playwright-report/

# Rust build output
contracts/target/
contracts/tests/failed_txs/
