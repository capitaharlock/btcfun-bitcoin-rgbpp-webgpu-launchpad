# Bitcoin network. "testnet4" (default) or "mainnet".
VITE_BITCOIN_NETWORK=testnet4

# Mempool-compatible API for UTXOs, fees, tip height and broadcast.
VITE_MEMPOOL_API=https://mempool.space/testnet4/api

# Where the activity index lives. Empty means same-origin /api, which is what
# the Cloudflare Worker serves; set it only when the two are deployed apart.
VITE_API_BASE=

# WebAuthn relying party id.
#
# Leave unset: the page's own hostname is always valid for its own origin.
# Set it to the registrable domain ONLY when the app is served from several
# subdomains that must share one wallet — and never to a public suffix such as
# workers.dev or co.uk, which every authenticator rejects.
#
# It is recorded in the credential, so changing it later is a wallet migration.
VITE_RP_ID=
