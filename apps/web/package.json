{
  "name": "@btcfun/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:ui": "node scripts/verify-ui.mjs",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json && tsc -p e2e.tsconfig.json",
    "db:local": "wrangler d1 execute btcfun-activity --local --file=worker/schema.sql",
    "db:remote": "wrangler d1 execute btcfun-activity --remote --file=worker/schema.sql",
    "dev:edge": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "e2e:wallet": "node scripts/e2e/cli.mjs wallet",
    "e2e:balance": "node scripts/e2e/cli.mjs balance",
    "rgbpp:live": "node scripts/rgbpp/live.mjs",
    "ckb:deploy-mint": "node scripts/ckb/deploy-mint.mjs",
    "test:browser": "playwright test --project=ui --project=mobile",
    "test:browser:headed": "HEADED=1 playwright test --project=ui --project=mobile",
    "test:browser:live": "E2E_LIVE=1 HEADED=1 playwright test --project=live",
    "test:report": "node scripts/test-report.mjs"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.22.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@scure/btc-signer": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.136.3"
  }
}
